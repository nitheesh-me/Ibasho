/-
`lake exe ibasho-gen [--out DIR] [--check] [--audit]` (ARCH 8.2, BUILD_PLAN D6). Owner: WP-04.

Writes `packages/spec-gen/src/generated/**` from the Lean spec and checker: `spec.ts` (weights,
groups, anchors, R and T parameters, bands, fixed-point constants, limits, claim keys),
`rules.ts` (named functions and built-in rule ids), `cert.ts` (the `ibasho.cert/2` types and
check ids), `cert.schema.json`, `seals.json` (claims, theorems, statements and axioms read from
the compiled environment) and `specHash.ts` (the hash and the manifest it covers).

`--check` writes nothing and exits 1 when any file differs from what it would write (CI drift
gate D6). `--audit` also prints every seal theorem with its axioms and exits 1 if one uses an
axiom other than `propext`, `Classical.choice` and `Quot.sound`.

The output is formatted the way Biome formats it (2 spaces, width 110, single quotes in TS,
trailing commas), so `pnpm lint` accepts it unchanged.
-/
import Lean
import Ibasho.Spec.V2
import Ibasho.Check

open Lean Ibasho.Spec.V2 Ibasho.Check

namespace Gen

/-! ## A small pretty printer that matches Biome -/

/-- A value: `raw` is an already rendered atom; object keys are already rendered. -/
inductive V where
  | raw (s : String)
  | arr (xs : List V)
  | obj (kvs : List (String × V))

def width : Nat := 110

def jsonEscape (s : String) : String :=
  s.foldl (fun acc c =>
    acc ++ match c with
      | '"' => "\\\"" | '\\' => "\\\\" | '\n' => "\\n" | '\t' => "\\t"
      | c => c.toString) ""

def jstr (s : String) : V := .raw s!"\"{jsonEscape s}\""
def tstr (s : String) : V := .raw s!"'{s}'"
def num (n : Nat) : V := .raw (toString n)
def bool (b : Bool) : V := .raw (if b then "true" else "false")

def isIdent (s : String) : Bool :=
  !s.isEmpty && s.all (fun c => c.isAlphanum || c == '_' || c == '$') && !(s.front.isDigit)

def jobj (kvs : List (String × V)) : V := .obj (kvs.map fun (k, v) => (s!"\"{jsonEscape k}\"", v))
def tobj (kvs : List (String × V)) : V := .obj (kvs.map fun (k, v) => (if isIdent k then k else s!"'{k}'", v))

partial def flat : V → Option String
  | .raw s => some s
  | .arr [] => some "[]"
  | .arr xs => do
    let parts ← xs.mapM flat
    return "[" ++ ", ".intercalate parts ++ "]"
  | .obj [] => some "{}"
  | .obj _ => none

def ind (n : Nat) : String := String.ofList (List.replicate n ' ')

/-- Render `v` at indentation `i`, after `pre` and before `post` on the same line. `trailing`
is the separator after a broken list's last element (`","` in TS, `""` in JSON). -/
partial def render (trailing : String) (i : Nat) (pre post : String) (v : V) : String :=
  match flat v with
  | some s =>
    if i + pre.length + s.length + post.length ≤ width || (match v with | .raw _ => true | _ => false)
    then ind i ++ pre ++ s ++ post
    else broken
  | none => broken
where
  broken : String :=
    match v with
    | .raw s => ind i ++ pre ++ s ++ post
    | .arr xs =>
      let n := xs.length
      let body := (xs.zipIdx.map fun (x, k) =>
        render trailing (i + 2) "" (if k + 1 == n then trailing else ",") x)
      ind i ++ pre ++ "[\n" ++ "\n".intercalate body ++ "\n" ++ ind i ++ "]" ++ post
    | .obj kvs =>
      let n := kvs.length
      let body := (kvs.zipIdx.map fun ((k, x), j) =>
        render trailing (i + 2) (k ++ ": ") (if j + 1 == n then trailing else ",") x)
      ind i ++ pre ++ "{\n" ++ "\n".intercalate body ++ "\n" ++ ind i ++ "}" ++ post

def json (v : V) : String := render "" 0 "" "" v ++ "\n"

/-- `export const NAME: TYPE = value;` -/
def tsConst (name ty : String) (v : V) (doc : Option String := none) : String :=
  (match doc with | some d => s!"/** {d} */\n" | none => "") ++
  render "," 0 s!"export const {name}{if ty.isEmpty then "" else ": " ++ ty} = " ";" v

/-- `export type NAME = 'a' | 'b';`, broken with leading bars when it does not fit. -/
def tsUnion (name : String) (xs : List String) (doc : Option String := none) : String :=
  let head := (match doc with | some d => s!"/** {d} */\n" | none => "")
  let one := s!"export type {name} = {" | ".intercalate (xs.map fun x => s!"'{x}'")};"
  if one.length ≤ width then head ++ one
  else head ++ s!"export type {name} =\n" ++ "\n".intercalate (xs.map fun x => s!"  | '{x}'") ++ ";"

def header (what : String) : String :=
  s!"// GENERATED by `lake exe ibasho-gen` from proofs/ (Lean). Do not edit: change the Lean source and\n" ++
  s!"// rerun `pnpm --filter @ibasho/spec-gen gen`. CI fails on drift (`ibasho-gen --check`, D6).\n// {what}"

def file (parts : List String) : String := "\n\n".intercalate parts ++ "\n"

/-! ## spec.ts -/

def dimName := Ibasho.Check.Dim.name
def groupName := Ibasho.Check.Group.name

def anchorTable (an : AMode → Anchors) : V :=
  tobj ([AMode.burden, AMode.perArea].map fun mode =>
    ((match mode with | .burden => "burden" | .perArea => "per-area"),
      tobj (Dim.all.map fun d =>
        (dimName d, tobj [("best", tstr (ratWire (an mode d).best)),
                          ("worst", tstr (ratWire (an mode d).worst))]))))

def specTs : String := file [
  header "Spec constants (ARCH 8.2): Ibasho.Spec.V2.Score, Fixed, Units and Ibasho.Check.Ids.\n// Rationals are wire strings (\"n/d\"), parsed with `Q.fromWire` in @ibasho/core.",
  tsUnion "ScoreDim" (Dim.all.map dimName),
  tsConst "SCORE_DIMS" "readonly ScoreDim[]" (.arr (Dim.all.map (tstr ∘ dimName))),
  tsConst "SCORE_WEIGHTS" "Readonly<Record<ScoreDim, string>>"
    (tobj (Dim.all.map fun d => (dimName d, tstr (ratWire (weight d)))))
    (some "SPEC R2 (`weight`). Sum is 1 (Lean `weights_sum_one`)."),
  tsUnion "ScoreGroup" (Ibasho.Spec.V2.Group.all.map groupName),
  tsConst "SCORE_GROUPS" "Readonly<Record<ScoreGroup, readonly ScoreDim[]>>"
    (tobj (Ibasho.Spec.V2.Group.all.map fun g => (groupName g, .arr (g.dims.map (tstr ∘ dimName)))))
    (some "SPEC R2 display groups (`Group.dims`)."),
  tsUnion "AnchorZone" ["uk", "in"],
  tsUnion "AnchorMode" ["burden", "per-area"],
  "export interface Anchor {\n  best: string;\n  worst: string;\n}",
  "export type AnchorTable = Readonly<Record<ScoreDim, Anchor>>;",
  tsConst "ANCHORS" "Readonly<Record<AnchorZone, Readonly<Record<AnchorMode, AnchorTable>>>>"
    (tobj [("uk", anchorTable ukAnchors), ("in", anchorTable inAnchors)])
    (some "Score anchors per climate zone and cost mode (`ukAnchors`, `inAnchors`; `anchors_valid`)."),
  tsConst "R_TARGET" "Readonly<Record<AnchorZone, string>>"
    (tobj [("uk", tstr (ratWire ukRTarget)), ("in", tstr (ratWire inRTarget))])
    (some "Renewable share target of the R composite (`ukRTarget`, `inRTarget`)."),
  tsConst "T_CAPS" "Readonly<Record<AnchorZone, { hot: string; cold: string }>>"
    (tobj [("uk", tobj [("hot", tstr (ratWire ukTCaps.1)), ("cold", tstr (ratWire ukTCaps.2))]),
           ("in", tobj [("hot", tstr (ratWire inTCaps.1)), ("cold", tstr (ratWire inTCaps.2))])])
    (some "Comfort hour caps of the T composite (`ukTCaps`, `inTCaps`)."),
  tsConst "BAND_THRESHOLDS" "readonly { band: 'A' | 'B' | 'C' | 'D' | 'E' | 'F'; minSap: number }[]"
    (.arr (bandThresholds.map fun (b, t) => tobj [("band", tstr b), ("minSap", num t)]))
    (some "SPEC 8: estimated EPC band edges on the SAP scale (`sapBand`); below F is G."),
  tsConst "FIXED" ""
    (tobj [("dfScale", tstr (toString dfScale)), ("ppb", tstr (toString ppb)),
           ("microPencePerPound", tstr (toString microPencePerPound)),
           ("ugPerG", tstr (toString ugPerG))])
    (some "SPEC 7.4 fixed-point constants (decimal strings; parse with BigInt)."),
  tsConst "SEARCH_LIMITS" ""
    (tobj [("heavy", num searchLimitHeavy), ("packages", num searchLimitPackages)])
    (some "SPEC R9 completeness limits of the exhaustive search."),
  tsUnion "ClaimKey" ["nothing-better-hidden", "rejected-never-returned", "every-rule-passed",
    "picks-as-named", "noise-decided-soundly", "score-bookkeeping"]
    (some "SPEC 7.3 claim ids. Theorems, statements and axioms live in seals.json.")]

/-! ## rules.ts -/

def rulesTs : String := file [
  header "Named rule functions (ARCH 5.4) and built-in rule ids: Ibasho.Check.Ids.",
  tsUnion "NamedFn" (namedFns.map (·.1)),
  tsConst "NAMED_FNS" "readonly NamedFn[]" (.arr (namedFns.map (tstr ·.1))),
  tsConst "NAMED_FN_IMPLEMENTED" "Readonly<Record<NamedFn, boolean>>"
    (tobj (namedFns.map fun (f, b) => (f, bool b)))
    (some "True once the Lean definition is wired into the checker; until then a rule using it is unknown."),
  tsConst "BUILTIN_RULE_IDS" "readonly string[]"
    (.arr ((builtinRules.map (tstr ·.rule.id)) ++ [tstr builtinMemory, tstr builtinTarget]))
    (some "Rule ids the search adds itself (SPEC 9 built-ins).")]

/-! ## cert.ts -/

def certTypes : String :=
"export type CertRunMode = 'rating' | 'standard' | 'your-home';
export type CertTri = true | false | 'unknown';
/** Base64 of a little-endian typed array (int64, u32 or u8 as named by the field). */
export type B64 = string;
/** Decimal integer string. */
export type DecInt = string;

export interface CertPackData {
  id: string;
  version: string;
  /** Pack payload; checked by the `packs.wellformed` predicates, not for equality. */
  data: unknown;
}

/** Per option: the measure model id (memory) and measure kind (rule `measures` filter). */
export interface CertOptionMeta {
  measure: string;
  kind: string;
}

export interface CertGroup {
  id: string;
  /** Includes `none` when the group may be left out. */
  options: string[];
  /** Option id to fact table used by the Kleene evaluator (plus `c.*` cost keys). */
  facts: Record<string, Record<string, CertTri | number | string>>;
  /** Required by `feas.recompute`; the verify emitter adds it until the engine does. */
  optionMeta?: Record<string, CertOptionMeta>;
}

/** Twin facts the rules read (`h.*`), the region and recorded checks. */
export interface CertHome {
  region?: string;
  facts: Record<string, CertTri | number | string>;
  checks: { kind: string; at: string; result: 'pass' | 'conditional' | 'fail' }[];
}

/** One scored package (`score.recompute`). Rationals in wire form (`Q.toWire`): `n` or `n/d`. */
export interface CertScoreRow {
  row: number;
  /** Seven indicators in `SCORE_DIMS` order (R and T as composites), standard mode (trusted physics). */
  indicators: string[];
  /** Claimed sub-scores, `SCORE_DIMS` order, 0 to 100. */
  sub: string[];
  /** Claimed group scores, `SCORE_GROUPS` order, 0 to 100. */
  groups: string[];
  total: string;
}

/** Claimed scores of the displayed packages (at least the front and the picks). */
export interface CertScore {
  zone: 'uk' | 'in';
  mode: 'burden' | 'per-area';
  /** Strictly increasing by row. */
  rows: CertScoreRow[];
}

export interface Certificate {
  schema: 'ibasho.cert/2';
  specHash: string;
  engine: { version: string };
  packs: {
    tariffs: CertPackData[];
    carbon: CertPackData;
    trajectory: CertPackData;
    grants: CertPackData[];
    rules: CertPackData[];
    value: CertPackData;
  };
  context: {
    owner: Record<string, unknown>;
    target: Record<string, unknown>;
    /** Ruled out and done measures (option or measure ids); the search offers neither. */
    memory: { rejected: string[]; completed: string[] };
    asOf: string;
    home?: CertHome;
  };
  groups: CertGroup[];
  /** int64 fuel by month per mode (trusted physics). */
  baseline: Record<CertRunMode, B64>;
  /** Heavy keys and their delivered energy per mode (trusted physics). */
  heavy: { keys: string[]; delivered: Partial<Record<CertRunMode, B64>> };
  /** Sparse int64 deltas per light variant (trusted physics). */
  light: { delivered: B64 };
  claimed: {
    status: B64;
    n0: B64;
    npv: B64;
    carbonSaved: B64;
    witness: B64;
    ruleIds: string[][];
    /** int64 [row][fuel] annual saving, Wh (`acct.saving`). */
    saving?: B64;
    /** int64 [row] annual operational carbon saved, g (`acct.carbon`). */
    carbonAnnual?: B64;
    /** int64 [row][fuel] annual your-home bill, micro-pence (`money.bills`). */
    bills?: B64;
    /** Scores of the displayed packages (`score.recompute`; skipped when absent). */
    score?: CertScore;
  };
  front: B64;
  picks: { leastUpfront?: number; bestReturn?: number; lowestRunningCarbon?: number };
  needsCheck: B64;
}"

def checkSkipped : V :=
  tobj (skipReasons.map fun (id, why) => (id.name, tstr why))

def certTs : String := file [
  header "Certificate `ibasho.cert/2` (ARCH 8.3) and the checks of Ibasho.Check.Check. Columnar; integers travel\n// as decimal strings or base64 of little-endian int64/u32/u8 arrays, never as JSON floats.",
  certTypes,
  tsUnion "CertCheckId" (CheckId.all.map (·.name)) (some "Check ids (ARCH 8.3); the Lean checker and the TS mirror use the same ids."),
  tsConst "CERT_CHECK_IDS" "readonly CertCheckId[]" (.arr (CheckId.all.map (tstr ·.name))),
  tsConst "CERT_SKIPPED_CHECKS" "Readonly<Partial<Record<CertCheckId, string>>>" checkSkipped
    (some "Checks skipped when the certificate does not claim what they check, with the reason."),
  tsConst "CERT_STATUS" ""
    (tobj [("feasible", num stFeasible), ("needsCheck", num stNeedsCheck), ("blocked", num stBlocked),
           ("targetMiss", num stTargetMiss)])
    (some "Package status codes of `claimed.status` (core `PACKAGE_STATUS`)."),
  tsConst "CERT_NO_WITNESS" "" (.raw (toString noWitness)) (some "The `claimed.witness` marker for no witness (u32 all ones).")]

/-! ## cert.schema.json -/

def jtype (t : String) : V := jobj [("type", jstr t)]
def jreq (xs : List String) : V := .arr (xs.map jstr)
def qwire : V := jobj [("type", jstr "string"), ("pattern", jstr "^-?[0-9]+(/[0-9]+)?$")]
def b64 : V := jobj [("type", jstr "string"), ("pattern", jstr "^[A-Za-z0-9+/]*={0,2}$")]

def certSchema : String := json (jobj [
  ("$schema", jstr "https://json-schema.org/draft/2020-12/schema"),
  ("$id", jstr "https://ibasho.local/schemas/ibasho.cert-2.json"),
  ("$comment", jstr "GENERATED by lake exe ibasho-gen. Shape only; the checks are in Lean (Ibasho.Check)."),
  ("title", jstr "ibasho.cert/2"),
  ("type", jstr "object"),
  ("required", jreq ["schema", "specHash", "engine", "packs", "context", "groups", "baseline", "heavy",
    "light", "claimed", "front", "picks", "needsCheck"]),
  ("properties", jobj [
    ("schema", jobj [("const", jstr "ibasho.cert/2")]),
    ("specHash", jobj [("type", jstr "string"), ("pattern", jstr "^[0-9a-f]{64}$")]),
    ("engine", jobj [("type", jstr "object"), ("required", jreq ["version"])]),
    ("packs", jobj [("type", jstr "object"),
      ("required", jreq ["tariffs", "carbon", "trajectory", "grants", "rules", "value"])]),
    ("context", jobj [("type", jstr "object"), ("required", jreq ["owner", "target", "memory", "asOf"]),
      ("properties", jobj [("memory", jobj [("type", jstr "object"), ("required", jreq ["rejected", "completed"])]),
        ("asOf", jobj [("type", jstr "string"), ("pattern", jstr "^[0-9]{4}-[0-9]{2}-[0-9]{2}$")])])]),
    ("groups", jobj [("type", jstr "array"), ("items", jobj [("type", jstr "object"),
      ("required", jreq ["id", "options", "facts"])])]),
    ("baseline", jobj [("type", jstr "object"), ("required", jreq ["rating", "standard", "your-home"]),
      ("additionalProperties", b64)]),
    ("heavy", jobj [("type", jstr "object"), ("required", jreq ["keys", "delivered"])]),
    ("light", jobj [("type", jstr "object"), ("required", jreq ["delivered"]),
      ("properties", jobj [("delivered", b64)])]),
    ("claimed", jobj [("type", jstr "object"),
      ("required", jreq ["status", "n0", "npv", "carbonSaved", "witness", "ruleIds"]),
      ("properties", jobj [("status", b64), ("n0", b64), ("npv", b64), ("carbonSaved", b64),
        ("witness", b64), ("saving", b64), ("carbonAnnual", b64), ("bills", b64),
        ("score", jobj [("type", jstr "object"), ("required", jreq ["zone", "mode", "rows"]),
          ("properties", jobj [
            ("zone", jobj [("enum", .arr [jstr "uk", jstr "in"])]),
            ("mode", jobj [("enum", .arr [jstr "burden", jstr "per-area"])]),
            ("rows", jobj [("type", jstr "array"), ("items", jobj [("type", jstr "object"),
              ("required", jreq ["row", "indicators", "sub", "groups", "total"]),
              ("properties", jobj [("row", jtype "integer"),
                ("indicators", jobj [("type", jstr "array"), ("items", qwire)]),
                ("sub", jobj [("type", jstr "array"), ("items", qwire)]),
                ("groups", jobj [("type", jstr "array"), ("items", qwire)]),
                ("total", qwire)])])])])]),
        ("ruleIds", jobj [("type", jstr "array"), ("items", jobj [("type", jstr "array"),
          ("items", jtype "string")])])])]),
    ("front", b64),
    ("picks", jobj [("type", jstr "object"), ("properties", jobj [
      ("leastUpfront", jtype "integer"), ("bestReturn", jtype "integer"),
      ("lowestRunningCarbon", jtype "integer")])]),
    ("needsCheck", b64)])])

/-! ## seals.json -/

structure Claim where
  id : String
  sentence : String
  theorems : List String
  notProved : String

/-- SPEC 7.3. -/
def claims : List Claim := [
  ⟨"nothing-better-hidden", "Nothing better is hidden",
    ["check_sound", "checkFront_sound", "checkFront_complete", "witness_sound", "enum_complete_sound"],
    "The physics model's numbers are modelled, not proved."⟩,
  ⟨"rejected-never-returned", "What you ruled out never came back",
    ["rejected_never_offered", "rejection_antitone", "restore_monotone"],
    "Whether a ruled out measure would have suited you."⟩,
  ⟨"every-rule-passed", "Every option shown passes every rule we encoded",
    ["kleene_sound", "unknown_never_feasible", "feasibleB_sound"],
    "That our encoding matches the law. Check with your planning authority."⟩,
  ⟨"picks-as-named", "The three picks are what their names say",
    ["lexMin_nondominated", "checkPicks_sound"],
    "That the inputs to the ranking are accurate."⟩,
  ⟨"noise-decided-soundly", "The noise test is decided only when rounding cannot change it",
    ["noise_enclosure_sound", "noise_sum_ge_max"],
    "The unit's sound power figure, which comes from the maker."⟩,
  ⟨"score-bookkeeping", "Score bookkeeping is sound",
    ["weights_sum_one", "score_bounds", "score_monotone", "valid_score_bounds"],
    "That the score weights match what matters to you."⟩]

def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

def resolve (env : Environment) (short : String) : Option Name :=
  let cands : List Name := [`Ibasho.Check, `Ibasho.Spec.V2, `Ibasho.Spec.V2.Noise].map fun ns =>
    short.splitOn "." |>.foldl (fun n s => Name.mkStr n s) ns
  cands.find? env.contains

def oneLine (s : String) : String :=
  " ".intercalate (((s.replace "\n" " ").splitOn " ").filter (!·.isEmpty))

structure ThmInfo where
  short : String
  name : Name
  statement : String
  axioms : List Name

def theoremInfo (short : String) : CoreM ThmInfo := do
  let env ← getEnv
  let some n := resolve env short | throwError "seal theorem {short} not found"
  let some ci := env.find? n | throwError "seal theorem {short} not found"
  let fmt ← (Meta.ppExpr ci.type).run'
  let axs ← collectAxioms n
  return { short, name := n, statement := oneLine (fmt.pretty 100000), axioms := axs.toList.mergeSort (·.toString ≤ ·.toString) }

def sealsJson (infos : List ThmInfo) : String :=
  let thm (s : String) : V := match infos.find? (·.short == s) with
    | some t => jobj [("name", jstr t.short), ("decl", jstr t.name.toString),
        ("statement", jstr t.statement), ("axioms", .arr (t.axioms.map (jstr ·.toString)))]
    | none => jobj [("name", jstr s)]
  json (jobj [
    ("$comment", jstr "GENERATED by lake exe ibasho-gen from the compiled Lean environment (SPEC 7.3). Do not edit."),
    ("specHash", jstr specHash),
    ("claims", .arr (claims.map fun c => jobj [
      ("id", jstr c.id), ("sentence", jstr c.sentence),
      ("theorems", .arr (c.theorems.map thm)), ("notProved", jstr c.notProved)]))])

/-! ## specHash.ts -/

def specHashTs : String := file [
  header "`specHash` (DEC TE-2): the SHA-256 of SPEC_MANIFEST joined with newlines plus a final newline.",
  tsConst "SPEC_VERSION" "" (.raw s!"'{specVersion}' as const"),
  tsConst "SPEC_HASH" "" (.raw s!"'{specHash}' as const"),
  tsConst "HISTORICAL_SPEC_HASHES" "readonly string[]" (.arr (historicalSpecHashes.map tstr))
    (some "Older spec hashes whose certificates the checker still accepts."),
  tsConst "SPEC_GEN_IS_PLACEHOLDER" "" (.raw "false as boolean")
    (some "True only for placeholder spec-gen output."),
  tsConst "SPEC_MANIFEST" "readonly string[]"
    (.arr ((specManifest.splitOn "\n").filter (!·.isEmpty) |>.map tstr))
    (some "The canonical spec manifest (`Ibasho.Check.specManifest`), one fact per line.")]

/-! ## Driver -/

def findOut : IO System.FilePath := do
  for c in ["../packages/spec-gen/src/generated", "packages/spec-gen/src/generated"] do
    if ← System.FilePath.isDir c then return c
  throw (IO.userError "cannot find packages/spec-gen/src/generated; pass --out DIR")

def loadEnv : IO Environment := do
  initSearchPath (← findSysroot)
  importModules #[{ module := `Ibasho.Spec.V2 }, { module := `Ibasho.Check }] {} (trustLevel := 1024)

def runCore {α : Type} (env : Environment) (x : CoreM α) : IO α := do
  let (a, _) ← x.toIO { fileName := "<ibasho-gen>", fileMap := default, maxHeartbeats := 0 } { env }
  return a

end Gen

open Gen in
def main (args : List String) : IO UInt32 := do
  let check := args.contains "--check"
  let audit := args.contains "--audit"
  let out ← match args.dropWhile (· != "--out") with
    | _ :: d :: _ => pure (System.FilePath.mk d)
    | _ => findOut
  let env ← loadEnv
  let names := (claims.flatMap (·.theorems)).eraseDups
  let infos ← runCore env (names.mapM theoremInfo)
  let mut bad := false
  if audit then
    for t in infos do
      let extra := t.axioms.filter (!standardAxioms.contains ·)
      IO.println s!"{t.name}: {t.axioms}{if extra.isEmpty then "" else "  NON-STANDARD"}"
      unless extra.isEmpty do bad := true
  let files : List (String × String) := [
    ("spec.ts", specTs), ("rules.ts", rulesTs), ("cert.ts", certTs),
    ("cert.schema.json", certSchema), ("seals.json", sealsJson infos), ("specHash.ts", specHashTs)]
  let mut drift := false
  for (name, body) in files do
    let path := out / name
    let old ← (do pure (some (← IO.FS.readFile path))) <|> pure none
    if old == some body then continue
    if check then
      IO.eprintln s!"drift: {path} differs from ibasho-gen output"
      drift := true
    else
      let tmp := out / s!".{name}.tmp"
      IO.FS.writeFile tmp body
      IO.FS.rename tmp path
      IO.println s!"wrote {path}"
  if check && !drift then IO.println s!"ibasho-gen --check: {files.length} files clean (specHash {specHash})"
  return if drift || bad then 1 else 0
