{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibasho.local/schemas/ibasho.cert-2.json",
  "$comment": "GENERATED by lake exe ibasho-gen. Shape only; the checks are in Lean (Ibasho.Check).",
  "title": "ibasho.cert/2",
  "type": "object",
  "required": [
    "schema",
    "specHash",
    "engine",
    "packs",
    "context",
    "groups",
    "baseline",
    "heavy",
    "light",
    "claimed",
    "front",
    "picks",
    "needsCheck"
  ],
  "properties": {
    "schema": {
      "const": "ibasho.cert/2"
    },
    "specHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine": {
      "type": "object",
      "required": ["version"]
    },
    "packs": {
      "type": "object",
      "required": ["tariffs", "carbon", "trajectory", "grants", "rules", "value"]
    },
    "context": {
      "type": "object",
      "required": ["owner", "target", "memory", "asOf"],
      "properties": {
        "memory": {
          "type": "object",
          "required": ["rejected", "completed"]
        },
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "options", "facts"]
      }
    },
    "baseline": {
      "type": "object",
      "required": ["rating", "standard", "your-home"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9+/]*={0,2}$"
      }
    },
    "heavy": {
      "type": "object",
      "required": ["keys", "delivered"]
    },
    "light": {
      "type": "object",
      "required": ["delivered"],
      "properties": {
        "delivered": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "claimed": {
      "type": "object",
      "required": ["status", "n0", "npv", "carbonSaved", "witness", "ruleIds"],
      "properties": {
        "status": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "n0": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "npv": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "carbonSaved": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "witness": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "saving": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "carbonAnnual": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "bills": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "score": {
          "type": "object",
          "required": ["zone", "mode", "rows"],
          "properties": {
            "zone": {
              "enum": ["uk", "in"]
            },
            "mode": {
              "enum": ["burden", "per-area"]
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["row", "indicators", "sub", "groups", "total"],
                "properties": {
                  "row": {
                    "type": "integer"
                  },
                  "indicators": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[0-9]+)?$"
                    }
                  },
                  "sub": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[0-9]+)?$"
                    }
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(/[0-9]+)?$"
                    }
                  },
                  "total": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(/[0-9]+)?$"
                  }
                }
              }
            }
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "front": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "picks": {
      "type": "object",
      "properties": {
        "leastUpfront": {
          "type": "integer"
        },
        "bestReturn": {
          "type": "integer"
        },
        "lowestRunningCarbon": {
          "type": "integer"
        }
      }
    },
    "needsCheck": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  }
}
