{
  "name": "@ibasho/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Andon design system: tokens, CSS, components, mon icons, motion presets, `Num`, chart primitives, Storybook.",
  "exports": {
    ".": "./src/index.ts",
    "./andon.css": "./src/styles/andon.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens": "./src/tokens/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tokens": "tsx scripts/build-tokens.ts && biome format --write src/styles/tokens.css",
    "bake-glyphs": "tsx scripts/bake-glyphs.ts && biome format --write src/glyphs/baked.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1-code": "5.3.0",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@ibasho/core": "workspace:*",
    "@use-gesture/react": "10.3.1",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "opentype.js": "1.3.4",
    "storybook": "10.6.1"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
